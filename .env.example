# Copy to .env and choose your own values. Never commit .env.

# PostgreSQL (used by docker compose to create the database)
POSTGRES_USER=answerdesk
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_DB=answerdesk

# Backend, when run on your machine outside Docker (tests, alembic, uvicorn).
# Inside docker compose this is replaced with the "db" host automatically.
DATABASE_URL=postgresql+psycopg://answerdesk:choose-a-local-password@127.0.0.1:5432/answerdesk

# local | ci | production
ENVIRONMENT=local
